{
  "name": "@paraf/core",
  "version": "0.0.0",
  "description": "Headless approval workflow engine: flow definitions, validator, and runtime.",
  "license": "MIT",
  "author": "Iyon",
  "keywords": [
    "approval",
    "workflow",
    "bpm",
    "engine"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./flow.schema.json": "./dist/flow.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup && node scripts/emit-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  }
}

{
  "name": "@paraf/mysql",
  "version": "0.1.0",
  "description": "MySQL storage adapter for the Paraf approval workflow engine.",
  "license": "MIT",
  "author": "Iyon",
  "homepage": "https://github.com/iyonadryan/paraf/tree/main/packages/mysql#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iyonadryan/paraf.git",
    "directory": "packages/mysql"
  },
  "bugs": {
    "url": "https://github.com/iyonadryan/paraf/issues"
  },
  "keywords": [
    "approval",
    "workflow",
    "paraf",
    "mysql"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema.mysql.sql": "./schema.mysql.sql",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema.mysql.sql",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "schema": "node scripts/write-schema.ts"
  },
  "peerDependencies": {
    "@paraf/core": "workspace:^",
    "mysql2": "^3.9.0"
  },
  "devDependencies": {
    "@paraf/core": "workspace:*",
    "@paraf/store-tests": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "mysql2": "^3.24.6",
    "tsup": "^9.0.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
